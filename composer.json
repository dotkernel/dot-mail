{
    "name": "dotkernel/dot-mail",
    "type": "library",
    "description": "Dotkernel mail component based on symfony mailer",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-mail",
    "keywords": [
        "mail",
        "services",
        "symfony",
        "mailer",
        "event",
        "dot-event",
        "laminas",
        "laminas-dependency"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "dotkernel/dot-event": "^4.0",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "symfony/mailer": "v7.1.6"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "mikey179/vfsstream": "^v1.6.11",
        "phpstan/phpstan": "^2.1.17",
        "phpstan/phpstan-phpunit": "^2.0.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Mail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Mail\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    }
}
