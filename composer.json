{
    "name": "dotkernel/dot-mail",
    "type": "library",
    "description": "Dotkernel mail component based on Symfony Mailer, for any PSR-11 container",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-mail",
    "keywords": [
        "mail",
        "services",
        "symfony",
        "mailer",
        "event",
        "laminas",
        "psr-11"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "laminas/laminas-eventmanager": "^3.4",
        "laminas/laminas-stdlib": "^3.19",
        "psr/container": "^1.1 || ^2.0",
        "symfony/mailer": "^v7.1.6 || ^v8.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "mikey179/vfsstream": "^v1.6.11",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Mail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Mail\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    }
}
